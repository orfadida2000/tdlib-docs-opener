{
  "name": "tdlib-docs-opener",
  "displayName": "TDLib Docs Opener",
  "description": "Open TDLib function documentation from selected text inside VS Code integrated browser.",
  "version": "1.2.0",
  "publisher": "orfadida",
  "author": {
    "name": "Or Fadida",
    "email": "or@fadida.net"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orfadida2000/tdllib-docs-opener.git"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.109.0",
    "node": ">=18.17.0"
  },
  "keywords": [
    "tdlib",
    "docs",
    "opener",
    "vscode"
  ],
  "categories": [
    "Other"
  ],
  "main": "./index.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tdlibDocs.openEntityDocs",
        "title": "TDLib Docs: Open Entity Documentation",
        "category": "TDLib Docs"
      },
      {
        "command": "tdlibDocs.openFunctionsIndex",
        "title": "TDLib Docs: Open Functions Index",
        "category": "TDLib Docs"
      },
      {
        "command": "tdlibDocs.openClassesIndex",
        "title": "TDLib Docs: Open Classes Index",
        "category": "TDLib Docs"
      },
      {
        "command": "tdlibDocs.openDocsOverview",
        "title": "TDLib Docs: Open Documentation Overview",
        "category": "TDLib Docs"
      },
      {
        "command": "tdlibDocs.openTdlibOverview",
        "title": "TDLib Docs: Open TDLib Overview",
        "category": "TDLib Docs"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
